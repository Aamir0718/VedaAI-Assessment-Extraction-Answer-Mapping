# Google Gemini API key. Get one at https://aistudio.google.com/apikey
# Required for handwriting extraction, ambiguous-mapping resolution, and
# optional grading. Never committed — copy this file to .env.local.
GEMINI_API_KEY=

# Optional: override the default Gemini model (see lib/ai/client.ts for the default).
GEMINI_MODEL=gemini-2.5-flash

# Optional: max upload size per file, in megabytes.
MAX_FILE_SIZE_MB=20
